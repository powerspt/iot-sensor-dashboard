# 이 파일을 복사해 같은 폴더에 .env 로 저장하고 값을 채우세요.
#   cp .env.example .env

# 세션 비밀키: 길고 랜덤한 고정값(바뀌면 모든 로그인이 풀림)
# 생성 예:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=여기에-길고-랜덤한-고정값

# 공개할 호스트 포트 (기본 8000). 예: 80으로 바꾸면 http://<IP> 로 접속.
PORT=8000

# (선택) 관리자 계정: 값을 채우면 서버 시작 시 자동 생성 → /admin 에서 전체 현황 조회
ADMIN_USER=admin
ADMIN_PASSWORD=여기에-관리자-비밀번호
